baseUrl=https://YOUR-HOST:PORT

# 6-digit passcode to open the web console (never commit a real PIN)
ACCESS_PIN=123456

# Comma-separated merchant codes. Pick the active one in config.properties.
merchants=ExampleTest,OtherMerchant

ExampleTest.pin=YOUR_PIN
ExampleTest.apiKey=YOUR_API_KEY
ExampleTest.privateKey=YOUR_PRIVATE_KEY_BASE64
ExampleTest.publicKey=YOUR_PUBLIC_KEY_BASE64

OtherMerchant.pin=YOUR_PIN
OtherMerchant.apiKey=YOUR_API_KEY
OtherMerchant.privateKey=YOUR_PRIVATE_KEY_BASE64
OtherMerchant.publicKey=YOUR_PUBLIC_KEY_BASE64

# Package catalog for the web UI. Gitignored — never commit real codes.
# Format: CODE:AMOUNT:FAMILY:Label  (comma-separated)
# DB-style codes: BPN_OSJA15 = 1.5 USD, BPN_MET5G1 = 1.5 USD, etc.
paymentCodes=BPN_OSJA15:1.5:OSJA:OSJA 1.5,BPN_OSJA4:4:OSJA:OSJA 4,BPN_MET5G1:1.5:MET5G:MET 5G 1.5

# Optional per merchant (overrides shared paymentCodes for that merchant in the web UI)
# ExampleTest.paymentCodes=BPN_OSJA15:1.5:OSJA:OSJA 1.5,BPN_SEKSA:5:SEKSA:SEKSA 5,BPN_MONTHLY:1:MONTHLY:Monthly 1

# Java CLI selected package (paidAmount can be omitted if CODE is listed above)
paymentCode=BPN_OSJA15
paidAmount=1.5
msisdn=YOUR_CUSTOMER_MSISDN
