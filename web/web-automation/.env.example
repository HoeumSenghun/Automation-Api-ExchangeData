# Optional Next.js / Vercel extras only.
# Merchant keys (baseUrl, pin, apiKey, RSA) live in the repo-root .env
# Copy from: ../../.env.example  →  ../../.env
# `npm run dev` loads that root .env automatically.

# Optional. If set, the UI asks for this before running.
# RUN_SECRET=change-me

# Vercel: paste the repo-root .env file into MERCHANT_DOTENV
# MERCHANT_DOTENV=
